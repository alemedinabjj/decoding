# Banco — conexão do owner (dashboard, migrations, seed, rate limit)
# Neon:   postgresql://<owner>:<senha>@<host>/decoding?sslmode=verify-full
# Docker: postgresql://decoding_owner:decoding@localhost:5432/decoding
DATABASE_URL=

# Banco — role somente leitura usada pelas ferramentas da Iris
# Docker: postgresql://iris_reader:iris_reader@localhost:5432/decoding
DATABASE_URL_READONLY=

# OpenAI — usada apenas no servidor (nunca exposta ao navegador)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Limite de mensagens por IP por minuto para a Iris
IRIS_RATE_LIMIT_PER_MINUTE=10
